<Window x:Class="OneClickLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="一键启动器" Height="720" Width="980" MinHeight="560" MinWidth="820"
        Background="#F4F6F8"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1677FF" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,14" />
            <Setter Property="MinHeight" Value="58" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B42318" />
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListStateStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="一键启动器" FontSize="28" FontWeight="SemiBold" Foreground="#16202A" />
                <TextBlock Text="按编号顺序启动已启用的 EXE 程序" Margin="0,6,0,0" Foreground="#5B6775" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="+ 添加启动项"
                    Command="{Binding AddItemCommand}"
                    IsEnabled="{Binding CanEdit}"
                    HorizontalAlignment="Right" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource EmptyStateStyle}"
                    Background="White"
                    BorderBrush="#D8DEE6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="还没有启动程序"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Foreground="#16202A" />
                    <Button Content="+ 添加第一个启动程序"
                            Command="{Binding AddItemCommand}"
                            IsEnabled="{Binding CanEdit}"
                            Margin="0,22,0,0"
                            Padding="18,12"
                            MinWidth="190" />
                </StackPanel>
            </Border>

            <Grid Style="{StaticResource ListStateStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#D8DEE6"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="252" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="编号" Foreground="#5B6775" />
                                            <TextBlock Text="{Binding Number}" FontSize="30" FontWeight="SemiBold" Foreground="#16202A" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                            <TextBlock Text="程序路径：" Foreground="#5B6775" />
                                            <TextBlock Text="{Binding ExecutablePath}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"
                                                       FontSize="14"
                                                       Foreground="#16202A" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                            <TextBlock Text="延迟：" Foreground="#5B6775" />
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBox Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="72"
                                                         Height="34"
                                                         VerticalContentAlignment="Center"
                                                         IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TextBlock Text=" 秒"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                            </DockPanel>
                                        </StackPanel>

                                        <CheckBox Grid.Column="3"
                                                  Content="启用"
                                                  IsChecked="{Binding Enabled}"
                                                  IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  VerticalAlignment="Center"
                                                  FontSize="16" />

                                        <WrapPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="选择程序"
                                                    Command="{Binding DataContext.SelectExecutableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="打开位置"
                                                    Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="↑"
                                                    MinWidth="42"
                                                    ToolTip="上移"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="↓"
                                                    MinWidth="42"
                                                    ToolTip="下移"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="1"
                        Content="+ 添加启动项"
                        Command="{Binding AddItemCommand}"
                        IsEnabled="{Binding CanEdit}"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0" />
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D8DEE6"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding CurrentStatus}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#16202A"
                               Margin="0,0,0,8" />
                    <Border Grid.Row="1"
                            Background="#F7F9FB"
                            BorderBrush="#E3E8EF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding StatusLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,0,0,5" Foreground="#344054" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Button Grid.Column="1"
                        Content="▶ 一键启动"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LaunchAllCommand}"
                        VerticalAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</Window>
